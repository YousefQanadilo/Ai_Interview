# Dependencies and build output
node_modules/
build/
dist/
coverage/

# Logs
*.log

# Environment files: real secrets live here and are never committed.
# .env.example is the only one tracked (placeholders only).
.env*
!.env.example

# Local SQLite databases (Prisma creates prisma/dev.db; test:db makes temporary ones)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Private keys, certificates and keystores
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.keystore
id_rsa*
id_ed25519*

# Cloud / API credential files
credentials*.json
*-credentials.json
service-account*.json
client_secret*.json

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
